ANTHROPIC_API_KEY=
CHAT_SESSION_SECRET=change-this-long-random-secret
PORT=3000
# URL do webhook que recebe os leads (ex.: Google Apps Script, Zapier, Make).
# Se vazio, o endpoint /lead responde 503 e nenhum lead é enviado.
LEAD_WEBHOOK_URL=
# Opcional: domínios EXTERNOS extras autorizados a chamar a API, separados
# por vírgula. O site e o painel servidos por este próprio servidor já são
# aceitos automaticamente (same-origin) — não precisam ser listados aqui.
ALLOWED_ORIGIN=
